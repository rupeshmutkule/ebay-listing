<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>eBay Product Listing</title>
<style>
  :root {
    color-scheme: light;
    --bg: #5B5CEB;
    --panel: #ffffff;
    --panel-2: #fbfaf7;
    --text: #1d1d1f;
    --muted: #66615b;
    --accent: #0f5bd7;
    --accent-2: #0a3f95;
    --danger: #a61b1b;
    --border: #ded8cf;
    --shadow: 0 18px 50px rgba(40, 30, 10, 0.08);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #F6F1E8;
      /* radial-gradient(circle at top left, rgba(15, 91, 215, 0.12), transparent 28%),
      radial-gradient(circle at top right, rgba(166, 27, 27, 0.08), transparent 24%),
      linear-gradient(180deg, #f8f5ef 0%, var(--bg) 100%); */
    color: var(--text);
  }

  .shell {
    max-width: 1500px;
    margin: 0 auto;
    padding: 32px 20px 40px;
  }

  .hero {
    background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(251,250,247,0.96));
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow);
    padding: 24px;
    margin-bottom: 18px;
  }

  h3 {
    margin: 0;
    font-size: clamp(24px, 3vw, 36px);
    letter-spacing: -0.03em;
  }

  .lede {
    margin: 0;
    max-width: 760px;
    color: var(--muted);
    line-height: 1.55;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0;
  }

  .file-picker {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 11px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    color: var(--text);
    cursor: pointer;
  }

  #csvFile { max-width: 260px; align-self: center; }
  .photo-urls { min-width: 250px; min-height: 76px; border-radius: 8px; padding: 8px; font-size: 12px; }
  h2 { margin: 0 0 12px; font-size: 19px; }

  button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    padding: 11px 16px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(15, 91, 215, 0.18);
    transition: transform 120ms ease, background 120ms ease, opacity 120ms ease;
  }

  button:hover { background: var(--accent-2); transform: translateY(-1px); }
  button:disabled { cursor: not-allowed; opacity: 0.6; transform: none; }
  button.secondary { background: #4f4a44; }
  button.secondary:hover { background: #372f28; }
  button.danger { background: var(--danger); }
  button.danger:hover { background: #841515; }

  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
    padding: 18px;
    margin-bottom: 18px;
  }

  label {
    display: inline-block;
    margin-bottom: 8px;
    font-weight: 700;
  }

  textarea {
    width: 100%;
    min-height: 72px;
    border-radius: 14px;
    border: 1px solid var(--border);
    padding: 12px;
    font-family: Consolas, "Courier New", monospace;
    resize: vertical;
  }

  .status {
    font-size: 14px;
    line-height: 1.45;
    max-height: 340px;
    min-height: 90px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .log-line {
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--panel-2);
    border: 1px solid #efe7db;
  }

  .log-ok { color: #1a6b2b; }
  .log-bad { color: var(--danger); }
  .log-warn { color: #8d6200; }

  .summary {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
  }

  th, td {
    border-bottom: 1px solid #e8e1d8;
    padding: 10px 8px;
    font-size: 13px;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: #f6f1e8;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #5e564e;
  }

  img.thumb {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .job-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #eef4ff;
    color: #184fa1;
    font-size: 12px;
    font-weight: 700;
  }

  .job-pill.running { background: #fff4df; color: #936100; }
  .job-pill.failed { background: #ffe7e7; color: #9e1c1c; }
  .job-pill.completed { background: #eaf6ea; color: #216834; }

  @media (max-width: 720px) {
    .shell { padding: 16px; }
    .hero, .panel { padding: 16px; border-radius: 16px; }
    button { width: 100%; }
    .file-picker { justify-content: center; width: 100%; }
    #csvFile { max-width: 100%; width: 100%; }
  }
</style>
</head>
<body>
<div class="shell">
  <section class="hero">
    <h3>eBay Product Listing</h3>
  </section>

  <section class="panel">
    <div class="toolbar">
      <label for="csvFile">Product file:</label>
      <input id="csvFile" type="file" accept=".xlsx,.xls,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv" aria-label="Choose Excel or CSV product file">
      <button id="btnPublishSelected">Add Selected to Semi Equipment (Auth’n’Auth)</button>
      <button id="btnViewB" class="secondary">View products on Semi Equipment Store (Seller B)</button>
      <button id="btnViewDrafts" class="secondary">View Saved Drafts (This Browser)</button>
    </div>
  </section>

  <section class="panel">
    <h2>Activity and listing logs</h2>
    <div class="summary" id="jobSummary"></div>
    <div class="status" id="statusBox"></div>
  </section>

  <section class="panel">
    <h2 id="tableTitle">Product review</h2>
    <p class="summary">Upload a workbook, select products, and click Add Selected. Products without photos are saved in this browser only; products with photos are sent to eBay live. Freight rows are excluded.</p>
    <div id="tableWrap"></div>
  </section>
</div>

<script>
const apiKey = <%- JSON.stringify(apiKey) %>;
const statusBox = document.getElementById('statusBox');
const tableWrap = document.getElementById('tableWrap');
const jobSummary = document.getElementById('jobSummary');
const csvFile = document.getElementById('csvFile');
window.productRows = [];
window.selectedProductKeys = new Set();
window.draftMode = false;
try {
  const savedDrafts = JSON.parse(localStorage.getItem('semiEquipmentSavedDrafts') || '[]');
  window.savedDrafts = Array.isArray(savedDrafts) ? savedDrafts : [];
} catch {
  window.savedDrafts = [];
}

function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);
}

function log(msg, cls) {
  const line = document.createElement('div');
  line.className = `log-line ${cls ? `log-${cls}` : ''}`.trim();
  line.textContent = msg;
  statusBox.prepend(line);
  while (statusBox.children.length > 40) statusBox.removeChild(statusBox.lastElementChild);
}

async function loadReadiness() {
  try {
    const data = await callApi('/ebay-listings/readiness');
    const { readiness } = data;
    const missing = readiness.checks.filter(check => !check.ready);
    jobSummary.textContent = readiness.ready
      ? ''
      : `Setup needed: ${missing.map(check => `${check.name} — ${check.detail}`).join('; ')}`;
    if (missing.length) log(jobSummary.textContent, 'warn');
  } catch (error) {
    jobSummary.textContent = 'Listing service is not available.';
    log('Listing service routes are not loaded. Restart the Express app, then refresh this page.', 'warn');
  }
}

function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

async function callApi(url, options = {}) {
  const headers = {
    ...(options.headers || {}),
    ...(apiKey ? { 'X-Api-Key': apiKey } : {})
  };

  const res = await fetch(url, { ...options, headers });
  const text = await res.text();
  const contentType = res.headers.get('content-type') || '';
  let data = {};
  try {
    data = text ? JSON.parse(text) : {};
  } catch (parseErr) {
    data = { error: text || parseErr.message };
  }

  if (!res.ok) {
    if (contentType.includes('text/html') || /^\s*<!doctype html/i.test(text)) {
      throw new Error(res.status === 404 ? 'Listing service route is not loaded. Restart the Express app.' : `Server returned ${res.status}.`);
    }
    throw new Error(data.error ? JSON.stringify(data.error) : `Request failed (${res.status})`);
  }

  return data;
}

function renderTable(products) {
  if (!products.length) {
    tableWrap.innerHTML = '<p>No products found.</p>';
    return;
  }

  const rows = products.map(p => `
    <tr>
      <td><input type="checkbox" class="row-check" data-itemid="${escapeHtml(p.itemId)}"></td>
      <td>${p.image ? `<img class="thumb" src="${escapeHtml(p.image)}" alt="">` : ''}</td>
      <td>${escapeHtml(p.itemId)}</td>
      <td>${escapeHtml(p.sku || '')}</td>
      <td>${escapeHtml(p.title || '')}</td>
      <td>${escapeHtml(p.quantity)}</td>
      <td>${escapeHtml(p.status || '')}</td>
    </tr>
  `).join('');

  tableWrap.innerHTML = `
    <p><label><input type="checkbox" id="checkAll"> select all (${products.length})</label></p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>Image</th>
            <th>Item Number</th>
            <th>SKU</th>
            <th>Title</th>
            <th>Qty</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;

  document.getElementById('checkAll').onchange = (event) => {
    document.querySelectorAll('.row-check').forEach(cb => {
      cb.checked = event.target.checked;
    });
  };
}

function renderJob(job, prefix) {
  const suffix = job.error ? ` - ${job.error}` : '';
  const cls = job.status === 'failed' ? 'bad' : job.status === 'completed_with_errors' ? 'warn' : job.status === 'running' ? 'warn' : 'ok';
  log(
    `${prefix} ${job.jobId} [${job.status}] ${job.completed}/${job.total} completed, ${job.succeeded} succeeded, ${job.failed} failed${suffix}`,
    cls
  );
}

async function pollJob(jobId) {
  let lastCount = 0;
  let lastStatus = '';

  while (true) {
    let data;
    try {
      data = await callApi(`/api/migrate/jobs/${jobId}`);
    } catch (err) {
      if (err.message.includes('Job not found')) {
        log(`Job ${jobId} is no longer available on the server.`, 'bad');
        return null;
      }
      log(`Job poll failed: ${err.message} - retrying...`, 'warn');
      await sleep(3000);
      continue;
    }

    const job = data.job;

    if (job.results.length > lastCount) {
      const newResults = job.results.slice(lastCount);
      newResults.forEach(result => {
        if (result.success) {
          log(
            result.skipped
              ? `  ${result.itemId}: skipped - already completed in a previous run`
              : `  ${result.itemId}: now live on Semi Equipment as ${result.newItemIdOnB}, removed from Bridge Tronic Global`,
            'ok'
          );
        } else {
          log(`  ${result.itemId}: FAILED - ${result.error}`, 'bad');
        }
      });
      lastCount = job.results.length;
    }

    if (job.status !== lastStatus) {
      renderJob(job, 'Job update:');
      lastStatus = job.status;
    }

    if (['completed', 'completed_with_errors', 'failed'].includes(job.status)) {
      return job;
    }

    await sleep(2000);
  }
}

function rowKey(row) { return row.assetNumber ? `IBM-${row.assetNumber}` : `ROW-${row.rowNumber}`; }

function persistBrowserDrafts() {
  localStorage.setItem('semiEquipmentSavedDrafts', JSON.stringify(window.savedDrafts));
}

function renderReviewRows(rows, saved = false) {
  if (!rows.length) {
    tableWrap.innerHTML = saved ? '<p>No browser-saved products. Upload a workbook, select items without photos, and click Add Selected.</p>' : '<p>No product rows found.</p>';
    return;
  }
  const entries = rows.map(row => {
    const key = rowKey(row);
    const title = row.title || [row.make, row.model, row.equipmentType].filter(Boolean).join(' ');
    const shipping = row.shippingAmount ?? row.spreadsheetShipping;
    const invalid = row.issues?.length > 0 || shipping == null;
    const status = invalid ? (shipping == null ? 'Freight excluded' : 'Needs product data') : (row.photoUrls?.length ? 'Ready to publish live' : 'Saved in this browser when selected');
    return `<tr>
      <td><input type="checkbox" class="product-check" data-key="${escapeHtml(key)}" ${invalid ? 'disabled' : ''} ${window.selectedProductKeys.has(key) ? 'checked' : ''}></td>
      <td>${escapeHtml(row.rowNumber ?? '')}</td><td>${escapeHtml(row.assetNumber || '')}</td><td>${escapeHtml(title)}</td>
      <td>$${escapeHtml(row.askingPrice ?? '')}</td><td>$${escapeHtml(shipping ?? '')}</td>
      <td>${escapeHtml((row.photoUrls || []).length)} photo(s)${saved ? `<br><textarea class="photo-urls" data-photo-key="${escapeHtml(key)}" placeholder="Paste direct HTTPS photo URL(s), one per line">${escapeHtml((row.photoUrls || []).join('\n'))}</textarea><button class="save-browser-photos secondary" data-photo-key="${escapeHtml(key)}">Save photos</button>` : ''}</td>
      <td>${escapeHtml(status)}${row.askingPrice > 2000 ? '<br>Best Offer enabled' : ''}</td>
      <td>${escapeHtml(row.issues?.join('; ') || (row.photoUrls?.length ? 'Selected items will publish live' : 'No photo: app-only saved product; add photos before publishing'))}</td>
    </tr>`;
  }).join('');
  tableWrap.innerHTML = `<div class="table-wrap"><table><thead><tr><th>Select</th><th>Excel row</th><th>Asset #</th><th>Listing title</th><th>Price</th><th>Shipping</th><th>${saved ? 'Photo URLs to add' : 'Photos'}</th><th>Status</th><th>Details</th></tr></thead><tbody>${entries}</tbody></table></div>`;
  tableWrap.querySelectorAll('.product-check').forEach(check => check.addEventListener('change', () => {
    if (check.checked) window.selectedProductKeys.add(check.dataset.key);
    else window.selectedProductKeys.delete(check.dataset.key);
  }));
  tableWrap.querySelectorAll('.save-browser-photos').forEach(button => button.addEventListener('click', () => {
    const key = button.dataset.photoKey;
    const field = tableWrap.querySelector(`.photo-urls[data-photo-key="${CSS.escape(key)}"]`);
    const urls = field.value.split(/[\n;]+/).map(value => value.trim()).filter(Boolean);
    if (!urls.length || urls.some(value => { try { return new URL(value).protocol !== 'https:'; } catch { return true; } })) {
      return log('Add at least one valid HTTPS image URL for this saved product.', 'bad');
    }
    const draft = window.savedDrafts.find(item => rowKey(item) === key);
    if (!draft) return log('Saved browser draft not found. Re-upload the workbook and save the product again.', 'bad');
    draft.photoUrls = [...new Set(urls)];
    draft.status = 'ready to publish';
    persistBrowserDrafts();
    log(`Saved ${draft.photoUrls.length} photo URL(s) for ${rowKey(draft)} in this browser.`, 'ok');
    renderSavedDrafts();
  }));
}

function renderSavedDrafts() {
  document.getElementById('tableTitle').textContent = 'Saved drafts in this browser';
  window.draftMode = true;
  window.selectedProductKeys.clear();
  renderReviewRows(window.savedDrafts, true);
  jobSummary.textContent = `${window.savedDrafts.length} browser-saved product(s). These are not eBay/Semi Equipment drafts.`;
}

function renderProducts(products) {
  if (!products.length) {
    tableWrap.innerHTML = '<p>No live products were returned for Seller B.</p>';
    return;
  }
  const rows = products.map(product => `<tr>
    <td>${escapeHtml(product.itemId)}</td>
    <td>${escapeHtml(product.sku || '')}</td>
    <td>${escapeHtml(product.title || '')}</td>
    <td>${escapeHtml(product.price ?? '')}</td>
    <td>${escapeHtml(product.quantity ?? '')}</td>
    <td>${escapeHtml(product.status || '')}</td>
    <td><a href="https://www.ebay.com/itm/${encodeURIComponent(product.itemId)}" target="_blank" rel="noopener">View listing</a></td>
  </tr>`).join('');
  tableWrap.innerHTML = `<div class="table-wrap"><table><thead><tr><th>eBay item</th><th>SKU</th><th>Title</th><th>Price</th><th>Qty</th><th>Status</th><th>Link</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}

function updateSummary(preview) {
  const blockedByLocation = !preview.merchantLocationKeyConfigured;
  const setupCount = preview.setupIssues?.length || 0;
  jobSummary.textContent = preview.localOnly
    ? `${preview.total} rows · ${preview.shippingReady} have numeric shipping · ${preview.freightExcluded} Freight rows excluded · ${preview.eligible} ready for live publish · ${preview.skipped} need attention · ${preview.bestOfferEligible} above $2,000 · eBay requires a photo before publishing`
    : `${preview.total} rows · ${preview.eligible} data/shipping ready · ${preview.skipped} need attention · ${preview.bestOfferEligible} ready items over $2,000${setupCount ? ` · ${setupCount} account setup issue(s)` : ''}${blockedByLocation ? ' · Missing inventory location key' : ''}`;
  (preview.setupIssues || []).forEach(issue => log(`Account setup issue: ${typeof issue === 'string' ? issue : JSON.stringify(issue)}`, 'bad'));
}

csvFile.onchange = async () => {
  const file = csvFile.files[0];
  if (!file) return;
  const extension = file.name.toLowerCase().split('.').pop();
  if (!['csv', 'xlsx', 'xls'].includes(extension)) return log('Choose an .xlsx, .xls, or .csv file.', 'bad');
  if (file.size > 10 * 1024 * 1024) return log('File is larger than the 10 MB upload limit.', 'bad');

  const isCsv = extension === 'csv';
  const contentType = isCsv ? 'text/csv' : extension === 'xls' ? 'application/vnd.ms-excel' : 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
  try {
    const fileBody = isCsv ? await file.text() : await file.arrayBuffer();
    tableWrap.innerHTML = '<p>Reading the workbook and preparing product review…</p>';
    log(`Reading ${file.name}; this step does not create eBay listings.`, 'warn');
    const result = await callApi(isCsv ? '/ebay-listings/preview-csv' : '/ebay-listings/preview-workbook', {
      method: 'POST',
      headers: { 'Content-Type': contentType },
      body: fileBody
    });
    window.productRows = result.preview.rows || [];
    window.selectedProductKeys = new Set();
    window.draftMode = false;
    document.getElementById('tableTitle').textContent = 'Select products to add to Semi Equipment';
    renderReviewRows(window.productRows);
    const numeric = window.productRows.filter(row => row.shippingAmount != null).length;
    const freight = window.productRows.length - numeric;
    jobSummary.textContent = `${window.productRows.length} products · ${numeric} with numeric shipping · ${freight} Freight/blank rows excluded`;
    log(`Loaded ${window.productRows.length} rows. Select products, then click “Add Selected to Semi Equipment”. Missing-photo rows will be saved in this browser.`, 'ok');
  } catch (error) {
    log(`Upload / validation failed: ${error.message}`, 'bad');
  }
};

document.getElementById('btnViewDrafts').onclick = renderSavedDrafts;

document.getElementById('btnPublishSelected').onclick = async () => {
  const selected = window.draftMode
    ? window.savedDrafts.filter(row => window.selectedProductKeys.has(rowKey(row)))
    : window.productRows.filter(row => window.selectedProductKeys.has(rowKey(row)));
  if (!selected.length) return log('Choose the Excel file, then select at least one product.', 'warn');
  const invalid = selected.filter(row => row.issues?.length || (row.shippingAmount ?? row.spreadsheetShipping) == null);
  if (invalid.length) return log('One or more selected products have missing required data or Freight shipping; fix the workbook selection first.', 'bad');
  const needsPhotos = selected.filter(row => !(row.photoUrls || []).length);
  const withPhotos = selected.filter(row => (row.photoUrls || []).length);
  for (const row of needsPhotos) {
    const key = rowKey(row);
    if (!window.savedDrafts.some(saved => rowKey(saved) === key)) window.savedDrafts.push({ ...row, status: 'awaiting_photos', savedAt: new Date().toISOString() });
  }
  if (needsPhotos.length) {
    persistBrowserDrafts();
    log(`Saved ${needsPhotos.length} product(s) without photos in this browser. They are not drafts in eBay. Open “View Saved Drafts” to add photos later.`, 'warn');
  }
  if (!withPhotos.length) {
    window.selectedProductKeys.clear();
    return renderSavedDrafts();
  }
  if (!confirm(`Publish ${withPhotos.length} selected product(s) live on Semi Equipment now?`)) return log('Live publishing cancelled. Products without photos remain saved in this browser.', 'warn');
  try {
    log(`Publishing ${withPhotos.length} product(s) through Auth’n’Auth, one at a time...`, 'warn');
    const result = await callApi('/ebay-listings/publish-selected', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rows: withPhotos })
    });
    (result.results || []).forEach(item => {
      const success = item.status === 'published';
      log(success ? `Published ${item.sku} as ${item.itemId}: ${item.url}` : `${String(item.status || 'result').toUpperCase()} ${item.sku || ''}: ${item.error || item.issues?.join('; ') || item.reason || ''}`, success ? 'ok' : 'bad');
      if (success) window.savedDrafts = window.savedDrafts.filter(draft => rowKey(draft) !== `IBM-${String(item.sku || '').replace(/^IBM-/, '')}`);
    });
    persistBrowserDrafts();
    jobSummary.textContent = `${result.published} published live · ${result.blocked} blocked · ${result.failed} failed · ${result.skipped} already listed`;
    window.selectedProductKeys.clear();
  } catch (error) { log(`Live publishing failed: ${error.message}`, 'bad'); }
};

document.getElementById('btnViewB').onclick = async () => {
  const viewButton = document.getElementById('btnViewB');
  viewButton.disabled = true;
  window.draftMode = false;
  window.productRows = [];
  window.selectedProductKeys.clear();
  log('Loading live products from Semi Equipment Store using Seller B credentials...', 'warn');
  try {
    const data = await callApi('/ebay-store-migration/api/seller-b/products');
    document.getElementById('tableTitle').textContent = 'Live products on Semi Equipment Store (Seller B)';
    renderProducts(data.products || []);
    log(`Seller B returned ${data.count} live products.`, 'ok');
  } catch (error) {
    const expired = /hard expired|invalid access token|invalid_grant/i.test(error.message);
    log(`Seller B Auth’n’Auth product view failed: ${error.message}`, 'bad');
  } finally {
    viewButton.disabled = false;
  }
};

loadReadiness();
</script>
</body>
</html>
