<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>eBay Product Listing</title>
<style>
  :root {
    color-scheme: light;
    --bg: #5B5CEB;
    --panel: #ffffff;
    --panel-2: #fbfaf7;
    --text: #1d1d1f;
    --muted: #66615b;
    --accent: #0f5bd7;
    --accent-2: #0a3f95;
    --danger: #a61b1b;
    --border: #ded8cf;
    --shadow: 0 18px 50px rgba(40, 30, 10, 0.08);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #F6F1E8;
      /* radial-gradient(circle at top left, rgba(15, 91, 215, 0.12), transparent 28%),
      radial-gradient(circle at top right, rgba(166, 27, 27, 0.08), transparent 24%),
      linear-gradient(180deg, #f8f5ef 0%, var(--bg) 100%); */
    color: var(--text);
  }

  .shell {
    max-width: 1500px;
    margin: 0 auto;
    padding: 32px 20px 40px;
  }

  .hero {
    background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(251,250,247,0.96));
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow);
    padding: 24px;
    margin-bottom: 18px;
  }

  h3 {
    margin: 0;
    font-size: clamp(24px, 3vw, 36px);
    letter-spacing: -0.03em;
  }

  .lede {
    margin: 0;
    max-width: 760px;
    color: var(--muted);
    line-height: 1.55;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0;
  }

  .file-picker {
    display: inline-flex;
    align-items: center;
    margin: 0;
    padding: 11px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    color: var(--text);
    cursor: pointer;
  }

  #csvFile { max-width: 260px; align-self: center; }
  h2 { margin: 0 0 12px; font-size: 19px; }

  button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    padding: 11px 16px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(15, 91, 215, 0.18);
    transition: transform 120ms ease, background 120ms ease, opacity 120ms ease;
  }

  button:hover { background: var(--accent-2); transform: translateY(-1px); }
  button:disabled { cursor: not-allowed; opacity: 0.6; transform: none; }
  button.secondary { background: #4f4a44; }
  button.secondary:hover { background: #372f28; }
  button.danger { background: var(--danger); }
  button.danger:hover { background: #841515; }

  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
    padding: 18px;
    margin-bottom: 18px;
  }

  label {
    display: inline-block;
    margin-bottom: 8px;
    font-weight: 700;
  }

  textarea {
    width: 100%;
    min-height: 72px;
    border-radius: 14px;
    border: 1px solid var(--border);
    padding: 12px;
    font-family: Consolas, "Courier New", monospace;
    resize: vertical;
  }

  .status {
    font-size: 14px;
    line-height: 1.45;
    max-height: 340px;
    min-height: 90px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .log-line {
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--panel-2);
    border: 1px solid #efe7db;
  }

  .log-ok { color: #1a6b2b; }
  .log-bad { color: var(--danger); }
  .log-warn { color: #8d6200; }

  .summary {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
  }

  th, td {
    border-bottom: 1px solid #e8e1d8;
    padding: 10px 8px;
    font-size: 13px;
    text-align: left;
    vertical-align: top;
  }

  th {
    background: #f6f1e8;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #5e564e;
  }

  img.thumb {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
  }

  .job-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #eef4ff;
    color: #184fa1;
    font-size: 12px;
    font-weight: 700;
  }

  .job-pill.running { background: #fff4df; color: #936100; }
  .job-pill.failed { background: #ffe7e7; color: #9e1c1c; }
  .job-pill.completed { background: #eaf6ea; color: #216834; }

  @media (max-width: 720px) {
    .shell { padding: 16px; }
    .hero, .panel { padding: 16px; border-radius: 16px; }
    button { width: 100%; }
    .file-picker { justify-content: center; width: 100%; }
    #csvFile { max-width: 100%; width: 100%; }
  }
</style>
</head>
<body>
<div class="shell">
  <section class="hero">
    <h3>eBay Product Listing</h3>
  </section>

  <section class="panel">
    <div class="toolbar">
      <label for="csvFile">Product file:</label>
      <input id="csvFile" type="file" accept=".xlsx,.xls,.csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv" aria-label="Choose Excel or CSV product file">
      <button id="btnCreateDrafts">Upload &amp; Review Products</button>
      <button id="btnViewB" class="secondary">View products on Semi Equipment Store (Seller B)</button>
      <button id="btnConnectB" class="secondary" type="button">Connect Semi Equipment eBay</button>
    </div>
  </section>

  <section class="panel">
    <h2>Activity and listing logs</h2>
    <div class="summary" id="jobSummary"></div>
    <div class="status" id="statusBox"></div>
  </section>

  <section class="panel">
    <h2 id="tableTitle">Product review</h2>
    <div id="tableWrap"></div>
  </section>
</div>

<script>
const apiKey = <%- JSON.stringify(apiKey) %>;
const statusBox = document.getElementById('statusBox');
const tableWrap = document.getElementById('tableWrap');
const jobSummary = document.getElementById('jobSummary');
const csvFile = document.getElementById('csvFile');
const btnCreateDrafts = document.getElementById('btnCreateDrafts');
const btnConnectB = document.getElementById('btnConnectB');
window.currentUploadFile = null;
window.selectedListingRows = new Set();

function escapeHtml(value) {
  return String(value ?? '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;'
  })[ch]);
}

function log(msg, cls) {
  const line = document.createElement('div');
  line.className = `log-line ${cls ? `log-${cls}` : ''}`.trim();
  line.textContent = msg;
  statusBox.prepend(line);
  while (statusBox.children.length > 40) statusBox.removeChild(statusBox.lastElementChild);
}

async function loadReadiness() {
  try {
    const data = await callApi('/ebay-listings/readiness');
    const { readiness } = data;
    const missing = readiness.checks.filter(check => !check.ready);
    jobSummary.textContent = readiness.ready
      ? ''
      : `Setup needed: ${missing.map(check => `${check.name} — ${check.detail}`).join('; ')}`;
    if (missing.length) log(jobSummary.textContent, 'warn');
  } catch (error) {
    jobSummary.textContent = 'Listing service is not available.';
    log('Listing service routes are not loaded. Restart the Express app, then refresh this page.', 'warn');
  }
}

function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

async function callApi(url, options = {}) {
  const headers = {
    ...(options.headers || {}),
    ...(apiKey ? { 'X-Api-Key': apiKey } : {})
  };

  const res = await fetch(url, { ...options, headers });
  const text = await res.text();
  const contentType = res.headers.get('content-type') || '';
  let data = {};
  try {
    data = text ? JSON.parse(text) : {};
  } catch (parseErr) {
    data = { error: text || parseErr.message };
  }

  if (!res.ok) {
    if (contentType.includes('text/html') || /^\s*<!doctype html/i.test(text)) {
      throw new Error(res.status === 404 ? 'Listing service route is not loaded. Restart the Express app.' : `Server returned ${res.status}.`);
    }
    throw new Error(data.error ? JSON.stringify(data.error) : `Request failed (${res.status})`);
  }

  return data;
}

function renderTable(products) {
  if (!products.length) {
    tableWrap.innerHTML = '<p>No products found.</p>';
    return;
  }

  const rows = products.map(p => `
    <tr>
      <td><input type="checkbox" class="row-check" data-itemid="${escapeHtml(p.itemId)}"></td>
      <td>${p.image ? `<img class="thumb" src="${escapeHtml(p.image)}" alt="">` : ''}</td>
      <td>${escapeHtml(p.itemId)}</td>
      <td>${escapeHtml(p.sku || '')}</td>
      <td>${escapeHtml(p.title || '')}</td>
      <td>${escapeHtml(p.quantity)}</td>
      <td>${escapeHtml(p.status || '')}</td>
    </tr>
  `).join('');

  tableWrap.innerHTML = `
    <p><label><input type="checkbox" id="checkAll"> select all (${products.length})</label></p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th></th>
            <th>Image</th>
            <th>Item Number</th>
            <th>SKU</th>
            <th>Title</th>
            <th>Qty</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>
    </div>`;

  document.getElementById('checkAll').onchange = (event) => {
    document.querySelectorAll('.row-check').forEach(cb => {
      cb.checked = event.target.checked;
    });
  };
}

function renderJob(job, prefix) {
  const suffix = job.error ? ` - ${job.error}` : '';
  const cls = job.status === 'failed' ? 'bad' : job.status === 'completed_with_errors' ? 'warn' : job.status === 'running' ? 'warn' : 'ok';
  log(
    `${prefix} ${job.jobId} [${job.status}] ${job.completed}/${job.total} completed, ${job.succeeded} succeeded, ${job.failed} failed${suffix}`,
    cls
  );
}

async function pollJob(jobId) {
  let lastCount = 0;
  let lastStatus = '';

  while (true) {
    let data;
    try {
      data = await callApi(`/api/migrate/jobs/${jobId}`);
    } catch (err) {
      if (err.message.includes('Job not found')) {
        log(`Job ${jobId} is no longer available on the server.`, 'bad');
        return null;
      }
      log(`Job poll failed: ${err.message} - retrying...`, 'warn');
      await sleep(3000);
      continue;
    }

    const job = data.job;

    if (job.results.length > lastCount) {
      const newResults = job.results.slice(lastCount);
      newResults.forEach(result => {
        if (result.success) {
          log(
            result.skipped
              ? `  ${result.itemId}: skipped - already completed in a previous run`
              : `  ${result.itemId}: now live on Semi Equipment as ${result.newItemIdOnB}, removed from Bridge Tronic Global`,
            'ok'
          );
        } else {
          log(`  ${result.itemId}: FAILED - ${result.error}`, 'bad');
        }
      });
      lastCount = job.results.length;
    }

    if (job.status !== lastStatus) {
      renderJob(job, 'Job update:');
      lastStatus = job.status;
    }

    if (['completed', 'completed_with_errors', 'failed'].includes(job.status)) {
      return job;
    }

    await sleep(2000);
  }
}

function renderCsvRows(rows) {
  if (!rows.length) {
    tableWrap.innerHTML = '<p>No product rows found in the CSV.</p>';
    return;
  }
  const rowHtml = rows.map(row => {
    const status = row.status || (row.issues?.length ? 'needs attention' : row.policyValidationPending ? 'Excel data ready' : 'ready');
    const details = row.issues?.length ? row.issues.join('; ') : row.policyValidationPending ? 'Seller B shipping and listing policies checked when drafts are submitted' : `Shipping selected: $${row.selectedShipping ?? '—'}${row.shippingDifference ? ` (difference $${row.shippingDifference})` : ''}`;
    const offer = row.offerId ? `Offer ${row.offerId} (unpublished)` : '';
    const selectable = !(row.issues?.length) && !['draft', 'skipped', 'failed'].includes(row.status);
    return `<tr>
      <td><input type="checkbox" class="listing-row-check" data-row-number="${escapeHtml(row.rowNumber)}" ${selectable ? '' : 'disabled'} ${window.selectedListingRows.has(Number(row.rowNumber)) ? 'checked' : ''} aria-label="Select ${escapeHtml(row.title || row.assetNumber || `row ${row.rowNumber}`)}"></td>
      <td>${escapeHtml(row.rowNumber)}</td>
      <td>${escapeHtml(row.assetNumber)}</td>
      <td>${escapeHtml(row.title)}</td>
      <td>$${escapeHtml(row.askingPrice)}</td>
      <td>$${escapeHtml(row.spreadsheetShipping ?? '—')}</td>
      <td>${escapeHtml(status)}${offer ? `<br>${escapeHtml(offer)}` : ''}</td>
      <td>${escapeHtml(details)}${row.error ? `<br>${escapeHtml(JSON.stringify(row.error))}` : ''}${row.reason ? `<br>${escapeHtml(row.reason)}` : ''}</td>
    </tr>`;
  }).join('');
  tableWrap.innerHTML = `<div class="table-wrap"><table><thead><tr><th><input type="checkbox" id="selectAllReady" aria-label="Select all ready products"></th><th>Excel row</th><th>Asset #</th><th>Draft title</th><th>Price</th><th>Sheet shipping</th><th>Status</th><th>Details / missing data</th></tr></thead><tbody>${rowHtml}</tbody></table></div>`;
  const checks = [...tableWrap.querySelectorAll('.listing-row-check')];
  checks.forEach(check => check.addEventListener('change', () => {
    const rowNumber = Number(check.dataset.rowNumber);
    if (check.checked) window.selectedListingRows.add(rowNumber);
    else window.selectedListingRows.delete(rowNumber);
    document.getElementById('selectAllReady').checked = checks.filter(item => !item.disabled).every(item => item.checked);
  }));
  document.getElementById('selectAllReady').onchange = event => {
    checks.filter(item => !item.disabled).forEach(item => {
      item.checked = event.target.checked;
      const rowNumber = Number(item.dataset.rowNumber);
      if (item.checked) window.selectedListingRows.add(rowNumber);
      else window.selectedListingRows.delete(rowNumber);
    });
  };
}

function renderProducts(products) {
  if (!products.length) {
    tableWrap.innerHTML = '<p>No live products were returned for Seller B.</p>';
    return;
  }
  const rows = products.map(product => `<tr>
    <td>${escapeHtml(product.itemId)}</td>
    <td>${escapeHtml(product.sku || '')}</td>
    <td>${escapeHtml(product.title || '')}</td>
    <td>${escapeHtml(product.price ?? '')}</td>
    <td>${escapeHtml(product.quantity ?? '')}</td>
    <td>${escapeHtml(product.status || '')}</td>
    <td><a href="https://www.ebay.com/itm/${encodeURIComponent(product.itemId)}" target="_blank" rel="noopener">View listing</a></td>
  </tr>`).join('');
  tableWrap.innerHTML = `<div class="table-wrap"><table><thead><tr><th>eBay item</th><th>SKU</th><th>Title</th><th>Price</th><th>Qty</th><th>Status</th><th>Link</th></tr></thead><tbody>${rows}</tbody></table></div>`;
}

function updateSummary(preview) {
  const blockedByLocation = !preview.merchantLocationKeyConfigured;
  const setupCount = preview.setupIssues?.length || 0;
  jobSummary.textContent = preview.localOnly
    ? `${preview.total} rows loaded · ${preview.eligible} have required Excel data · ${preview.skipped} need attention · ${preview.bestOfferEligible} above $2,000 · Seller B checks run when drafts are submitted`
    : `${preview.total} rows · ${preview.eligible} data/shipping ready · ${preview.skipped} need attention · ${preview.bestOfferEligible} ready items over $2,000${setupCount ? ` · ${setupCount} account setup issue(s)` : ''}${blockedByLocation ? ' · Missing inventory location key' : ''}`;
  (preview.setupIssues || []).forEach(issue => log(`Account setup issue: ${typeof issue === 'string' ? issue : JSON.stringify(issue)}`, 'bad'));
}

async function pollDraftJob(jobId) {
  let lastCount = 0;
  while (true) {
    const data = await callApi(`/ebay-listings/drafts/${encodeURIComponent(jobId)}`);
    const job = data.job;
    jobSummary.textContent = `Draft job ${job.jobId}: ${job.status} · ${job.completed}/${job.total} processed · ${job.drafted} drafts · ${job.skipped} skipped · ${job.failed} failed`;
    if (job.results.length > lastCount) {
      lastCount = job.results.length;
      const resultsByRow = new Map(job.results.map(result => [result.rowNumber, result]));
      renderCsvRows(window.currentCsvPreview.rows.map(row => resultsByRow.get(row.rowNumber) || row));
    }
    if (['completed', 'completed_with_errors', 'failed'].includes(job.status)) {
      if (job.error) log(`Job stopped: ${JSON.stringify(job.error)}`, 'bad');
      log(`Finished: ${job.drafted} drafts, ${job.skipped} skipped, ${job.failed} failed.`, job.failed ? 'warn' : 'ok');
      return;
    }
    await sleep(1500);
  }
}

document.getElementById('btnCreateDrafts').onclick = async () => {
  const file = csvFile.files[0];
  if (!file) return log('Choose an Excel workbook (.xlsx or .xls) or CSV file first.', 'bad');
  const extension = file.name.toLowerCase().split('.').pop();
  if (!['csv', 'xlsx', 'xls'].includes(extension)) return log('Choose an .xlsx, .xls, or .csv file.', 'bad');
  if (file.size > 10 * 1024 * 1024) return log('File is larger than the 10 MB upload limit.', 'bad');

  btnCreateDrafts.disabled = true;
  const isCsv = extension === 'csv';
  const previewUrl = isCsv ? '/ebay-listings/preview-csv' : '/ebay-listings/preview-workbook';
  const contentType = isCsv ? 'text/csv' : extension === 'xls' ? 'application/vnd.ms-excel' : 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
  const draftsUrl = `/ebay-listings/drafts-selected?rowNumbers=${encodeURIComponent([...window.selectedListingRows].join(','))}`;
  try {
    const fileBody = isCsv ? await file.text() : await file.arrayBuffer();
    if (window.currentUploadFile === file && window.currentCsvPreview) {
      const selectedRows = window.currentCsvPreview.rows.filter(row => window.selectedListingRows.has(Number(row.rowNumber)) && !row.issues?.length);
      if (!selectedRows.length) {
        log('Select one or more ready products in the review table first.', 'warn');
        return;
      }
      const confirmed = confirm(`Create unpublished drafts for the ${selectedRows.length} selected products? Nothing will be published for sale.`);
      if (!confirmed) return log('Draft creation cancelled.', 'warn');
      log(`Creating drafts for ${selectedRows.length} selected products...`, 'warn');
      const started = await callApi(draftsUrl, {
        method: 'POST',
        headers: { 'Content-Type': contentType },
        body: fileBody
      });
      log(`Draft job started for selected products: ${started.job.jobId}`, 'ok');
      await pollDraftJob(started.job.jobId);
      return;
    }

    document.getElementById('tableTitle').textContent = 'Product review';
    tableWrap.innerHTML = '<p>Reading and validating product rows...</p>';
    log(`Validating ${file.name} before any eBay changes...`, 'warn');
    const previewResponse = await callApi(previewUrl, {
      method: 'POST',
      headers: { 'Content-Type': contentType },
      body: fileBody
    });
    const preview = previewResponse.preview;
    window.currentUploadFile = file;
    window.currentCsvPreview = preview;
    window.selectedListingRows = new Set();
    btnCreateDrafts.textContent = 'Create Drafts for Selected';
    updateSummary(preview);
    renderCsvRows(preview.rows);
    log(`Loaded ${preview.total} product rows from ${file.name}. Select the ready rows you want to list.`, preview.skipped ? 'warn' : 'ok');
    if (!preview.merchantLocationKeyConfigured) {
      log('Drafts are blocked until IBM_MERCHANT_LOCATION_KEY is configured for ZIP 85004.', 'bad');
      return;
    }
    if (preview.setupIssues?.length) {
      log('Draft creation is blocked until the account setup issues above are resolved.', 'bad');
      return;
    }
    if (!preview.eligible) {
      log('No rows are ready. Fix the CSV or eBay policies shown in the Details column, then upload again.', 'bad');
      return;
    }
    log('Select products in the table, then click “Create Drafts for Selected”.', 'ok');
  } catch (error) {
    log(`Upload / validation failed: ${error.message}`, 'bad');
  } finally {
    btnCreateDrafts.disabled = false;
  }
};

btnConnectB.onclick = async () => {
  btnConnectB.disabled = true;
  log('Preparing secure eBay authorization for Semi Equipment...', 'warn');
  try {
    const result = await callApi('/ebay-listings/oauth/authorize', { method: 'POST' });
    log('Opening eBay sign-in. Confirm you are using the Semi Equipment seller account.', 'ok');
    window.location.assign(result.authorizationUrl);
  } catch (error) {
    log(`Could not start eBay authorization: ${error.message}`, 'bad');
    btnConnectB.disabled = false;
  }
};

document.getElementById('btnViewB').onclick = async () => {
  const viewButton = document.getElementById('btnViewB');
  viewButton.disabled = true;
  log('Loading live products from Semi Equipment Store using Seller B credentials...', 'warn');
  try {
    const data = await callApi('/ebay-store-migration/api/seller-b/products');
    document.getElementById('tableTitle').textContent = 'Live products on Semi Equipment Store (Seller B)';
    renderProducts(data.products || []);
    log(`Seller B returned ${data.count} live products.`, 'ok');
  } catch (error) {
    const expired = /hard expired|invalid access token|invalid_grant/i.test(error.message);
    log(expired ? 'Seller B authorization expired. Reauthorize Seller B, then try again.' : `Seller B product view failed: ${error.message}`, 'bad');
  } finally {
    viewButton.disabled = false;
  }
};

loadReadiness();
</script>
</body>
</html>
